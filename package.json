{
  "name": "@palactix/publisher-widget",
  "version": "0.1.0",
  "description": "Embeddable publisher widget for Palactix — schedule and publish social media posts from any website.",
  "license": "MIT",
  "private": false,
  "type": "module",

  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "browser": "./dist/iife/loader.min.js",
  "types": "./dist/esm/index.d.ts",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/palactix/publisher-widget.git"
  },
  "homepage": "https://palactix.com",
  "bugs": {
    "url": "https://github.com/palactix/publisher-widget/issues"
  },
  "sideEffects": false,
  
  "author": {
    "name": "Jitendra Meena",
    "email": "jitendra@palactix.com",
    "url": "https://palactix.com"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "default": "./dist/iife/loader.min.js"
    }
  },
  
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "palactix",
    "publisher",
    "publisher-widget",
    "social",
    "social-media",
    "scheduler",
    "embed",
    "widget",
    "cdn",
    "unpkg",
    "jsdelivr",
    "npm",
    "esm",
    "iife",
    "loader"
  ]
}
